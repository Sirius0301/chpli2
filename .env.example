# Copy to .env for local development
DATABASE_URL="postgresql://chpli2:chpli2@localhost:5432/chpli2?schema=public"
API_PORT=4000

# JWT signing secret (required in production)
JWT_SECRET="dev-only-secret-change-me"

# Login verification-code delivery channel (M0 增强).
# "log" prints codes to the API server log and returns them as `devCode` in
# the /api/auth/code response (development/e2e only). Replace with a real
# SMTP/SMS transport before any production deployment.
AUTH_CODE_TRANSPORT="log"

# Object storage for memo images (M3). Defaults match infra/docker-compose.yml
# (MinIO via the bitnamilegacy image; any S3-compatible endpoint works).
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="chpli2"
S3_SECRET_KEY="chpli2-secret-key"
S3_BUCKET="chpli2-memo-images"
