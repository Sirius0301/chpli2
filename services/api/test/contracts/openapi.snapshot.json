  "info": {
    "title": "CHPLI2 API",
    "description": "CHPLI personal system API (Travel + Calendar slice)",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RouteEndpointDtoSchema": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "COUNTRY",
              "CITY",
              "LOCATION"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cityId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "level",
          "id",
          "name"
        ]
      },
      "TransportDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tripId": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "FLIGHT",
              "TRAIN",
              "BUS",
              "FERRY",
              "SUBWAY",
              "CAR",
              "WALK",
              "OTHER"
            ]
          },
          "origin": {
            "$ref": "#/components/schemas/RouteEndpointDtoSchema"
          },
          "destination": {
            "$ref": "#/components/schemas/RouteEndpointDtoSchema"
          },
          "plannedDepartureAt": {
            "type": "string",
            "nullable": true
          },
          "plannedArrivalAt": {
            "type": "string",
            "nullable": true
          },
          "actualDepartureAt": {
            "type": "string",
            "nullable": true
          },
          "actualArrivalAt": {
            "type": "string",
            "nullable": true
          },
          "calendarSync": {
            "type": "object",
            "nullable": true,
            "properties": {
              "eventId": {
                "type": "string"
              },
              "syncKey": {
                "type": "string"
              },
              "syncedAt": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "SYNCED",
                  "PENDING_DELETE"
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "tripId",
          "mode",
          "origin",
          "destination",
          "plannedDepartureAt",
          "plannedArrivalAt",
          "actualDepartureAt",
          "actualArrivalAt",
          "calendarSync"
        ]
      },
      "TripDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "PLAN",
              "MEMORY"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "transports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransportDtoSchema"
            }
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "createdAt",
          "updatedAt",
          "transports"
        ]
      },
      "CountryDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "code"
        ]
      },
      "CityDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "countryId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "countryId",
          "name"
        ]
      },
      "LocationDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cityId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "cityId",
          "name"
        ]
      },
      "CalendarDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "custom",
              "subscription"
            ]
          },
          "readonly": {
            "type": "boolean"
          },
          "regionCode": {
            "type": "string",
            "nullable": true
          },
          "isDefault": {
            "type": "boolean"
          },
          "sortOrder": {
            "type": "integer"
          },
          "hidden": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "color",
          "type",
          "readonly",
          "regionCode",
          "isDefault",
          "sortOrder",
          "hidden",
          "createdAt",
          "updatedAt"
        ]
      },
      "EventDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "calendarId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "startAt": {
            "type": "string"
          },
          "endAt": {
            "type": "string"
          },
          "allDay": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "sourceModule": {
            "type": "string",
            "nullable": true
          },
          "sourceRef": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "calendarId",
          "title",
          "startAt",
          "endAt",
          "allDay",
          "timezone",
          "location",
          "description",
          "sourceModule",
          "sourceRef",
          "createdAt",
          "updatedAt"
        ]
      },
      "ReminderDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "offsetDays": {
            "type": "integer"
          },
          "preset": {
            "type": "string",
            "enum": [
              "month",
              "week",
              "day",
              "custom"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sent",
              "dismissed"
            ]
          },
          "triggerAt": {
            "type": "string"
          },
          "sentAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "eventId",
          "offsetDays",
          "preset",
          "status",
          "triggerAt",
          "sentAt"
        ]
      },
      "DueReminderDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "offsetDays": {
            "type": "integer"
          },
          "preset": {
            "type": "string",
            "enum": [
              "month",
              "week",
              "day",
              "custom"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sent",
              "dismissed"
            ]
          },
          "triggerAt": {
            "type": "string"
          },
          "sentAt": {
            "type": "string",
            "nullable": true
          },
          "event": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "startAt": {
                "type": "string"
              },
              "allDay": {
                "type": "boolean"
              },
              "timezone": {
                "type": "string",
                "nullable": true
              },
              "calendarId": {
                "type": "string"
              },
              "calendarColor": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "eventId",
          "offsetDays",
          "preset",
          "status",
          "triggerAt",
          "sentAt",
          "event"
        ]
      },
      "HolidayEntryDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "regionCode": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "isWorkday": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "regionCode",
          "date",
          "name",
          "isWorkday"
        ]
      },
      "CalendarEventDtoSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "enum": [
                  "travel"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "transport"
                ]
              },
              "id": {
                "type": "string"
              },
              "tripId": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "title",
          "startsAt",
          "endsAt",
          "timezone",
          "source"
        ]
      }
    }
  }
}
