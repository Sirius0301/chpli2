generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique @db.VarChar(32)
  passwordHash String?    @db.VarChar(128) // null = password login disabled (bootstrap user)
  email        String?    @unique @db.VarChar(255) // stored lowercased (M0 增强)
  phone        String?    @unique @db.VarChar(32) // normalized: digits, optional leading +
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  trips        Trip[]
  calendars    Calendar[]
  memos        Memo[]
  notes        Note[]
  bookmarks    Bookmark[]
  loginCodes   LoginCode[]

  @@map("users")
}

model Country {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
}

model City {
  id        String     @id @default(cuid())
  countryId String
  country   Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]

  @@unique([countryId, name])
}

model Location {
  id        String   @id @default(cuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, name])
}

model Trip {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  title      String
  type       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  transports Transport[]

  @@index([userId])
}

model Transport {
  id                 String    @id @default(cuid())
  tripId             String
  trip               Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  mode               String
  originLevel        String
  originId           String
  destinationLevel   String
  destinationId      String
  plannedDepartureAt DateTime?
  plannedArrivalAt   DateTime?
  actualDepartureAt  DateTime?
  actualArrivalAt    DateTime?
  syncToCalendar     Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  payload     String
  occurredAt  DateTime  @default(now())
  processedAt DateTime?
}

model CalendarEvent {
  id           String    @id @default(cuid())
  userId       String
  title        String
  startsAt     DateTime
  endsAt       DateTime
  timezone     String    @default("UTC")
  sourceModule String
  sourceType   String
  sourceId     String
  syncKey      String    @unique
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


// ---------------------------------------------------------------------------
// Calendar module F1+F2: user calendars, events, reminders, holiday data.
// The calendar module owns these tables; other modules read via API only.
// ---------------------------------------------------------------------------

model Calendar {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  name       String    @db.VarChar(64)
  color      String    @db.Char(7)
  type       String // custom | subscription
  readonly   Boolean   @default(false)
  regionCode String?   @db.VarChar(16)
  isDefault  Boolean   @default(false)
  sortOrder  Int       @default(0)
  hidden     Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  events     Event[]

  @@index([type, regionCode])
  @@index([userId])
  @@map("calendars")
}

model Event {
  id           String     @id // client-generated uuid: idempotent create anchor
  calendarId   String
  calendar     Calendar   @relation(fields: [calendarId], references: [id])
  title        String     @db.VarChar(256)
  startAt      DateTime   @db.Timestamptz
  endAt        DateTime   @db.Timestamptz
  allDay       Boolean    @default(false)
  // null = floating time (wall-clock anchored); an IANA name = fixed zone (F4).
  timezone     String?    @db.VarChar(64) @default("UTC")
  location     String?    @db.VarChar(256)
  description  String?
  sourceModule String? // reserved for F7 cross-module sync
  sourceRef    String?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reminders    Reminder[]

  @@index([calendarId, startAt])
  @@map("events")
}

model Reminder {
  id         String    @id @default(uuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  offsetDays Int       @db.SmallInt
  preset     String // month | week | day | custom
  status     String    @default("pending") // pending | sent | dismissed
  triggerAt  DateTime  @db.Timestamptz
  sentAt     DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, triggerAt])
  @@map("reminders")
}

model HolidayEntry {
  id         String   @id @default(uuid())
  regionCode String   @db.VarChar(16)
  date       DateTime @db.Date
  nameZh     String   @db.VarChar(64)
  nameEn     String   @db.VarChar(64)
  nameDe     String   @db.VarChar(64)
  isWorkday  Boolean  @default(false)

  @@unique([regionCode, date])
  @@map("holiday_entries")
}

model LoginCode {
  id          String    @id @default(uuid())
  channel     String    @db.VarChar(8) // EMAIL | PHONE
  destination String    @db.VarChar(255) // normalized email or phone
  code        String    @db.VarChar(6)
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destination])
  @@map("login_codes")
}

// ---------------------------------------------------------------------------
// Calendar module M1 (Memo 化): date-only memos and per-instance completions.
// The calendar module owns these tables; other modules access via API only.
// ---------------------------------------------------------------------------

model Memo {
  id          String   @id // client-generated uuid: idempotent create anchor (E47)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String   @db.VarChar(256)
  date        DateTime @db.Date // pure date, no time/timezone semantics (M1 D1)
  priority    String   @default("none") @db.VarChar(8) // none | low | medium | high
  note        String?
  repeat      String   @default("none") @db.VarChar(16) // none + 9 rules (M1 2.3)
  repeatEnd   DateTime? @db.Date // inclusive; null = repeats forever
  tags        String[] @default([]) // free-text labels (M2): <=10, each <=32 chars
  completedAt DateTime? // non-repeating memos only; repeating use MemoCompletion (M1 D3)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completions MemoCompletion[]
  images      MemoImage[]

  @@index([userId, date])
  @@map("memos")
}

model MemoCompletion {
  id          String   @id @default(uuid())
  memoId      String
  memo        Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date // completed instance date
  completedAt DateTime @default(now())

  @@unique([memoId, date])
  @@map("memo_completions")
}

model MemoImage {
  id         String   @id // client-generated uuid: idempotent upload anchor (M3 D4)
  memoId     String
  memo       Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  storageKey String   @unique @db.VarChar(512) // object-storage key; the DB never holds file bodies
  fileName   String   @db.VarChar(256)
  mimeType   String   @db.VarChar(64)
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([memoId])
  @@map("memo_images")
}

// ---------------------------------------------------------------------------
// Notes module N1: markdown notes with tags/priority (Memo patterns reused).
// The notes module owns this table; other modules access via API only.
// ---------------------------------------------------------------------------

model Note {
  id        String   @id // client-generated uuid: idempotent create anchor
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String   @db.VarChar(256)
  body      String
  priority  String   @default("none") @db.VarChar(8) // none | low | medium | high
  tags      String[] @default([]) // <=10, each <=32 chars (Memo constraints)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  NoteVersion[]
  images    NoteImage[]

  @@index([userId, updatedAt])
  @@map("notes")
}

model NoteVersion {
  id        String   @id @default(uuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  seq       Int // per-note increasing version number
  title     String   @db.VarChar(256)
  body      String // full snapshot
  priority  String   @db.VarChar(8)
  tags      String[]
  createdAt DateTime @default(now())

  @@unique([noteId, seq])
  @@map("note_versions")
}

model NoteImage {
  id         String   @id // client-generated uuid: idempotent upload anchor (M3 D4)
  noteId     String
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  storageKey String   @unique @db.VarChar(512) // object-storage key; DB never holds bodies
  fileName   String   @db.VarChar(256)
  mimeType   String   @db.VarChar(64)
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([noteId])
  @@map("note_images")
}

// ---------------------------------------------------------------------------
// Bookmarks module B1: categorized bookmarks with click stats and a cover
// image (object storage; the DB holds metadata + storage key only).
// The bookmarks module owns this table; other modules access via API only.
// ---------------------------------------------------------------------------

model Bookmark {
  id           String    @id // client-generated uuid: idempotent create anchor
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  title        String    @db.VarChar(256)
  url          String    @db.VarChar(2048)
  domain       String    @db.VarChar(255) // hostname captured at save time
  description  String?
  categories   String[]  @default([]) // <=10, each <=32 chars (Memo tag rules)
  coverStorageKey String? @unique @db.VarChar(512)
  coverFileName   String? @db.VarChar(256)
  coverMimeType   String? @db.VarChar(64)
  clickCount   Int       @default(0)
  lastClickedAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@map("bookmarks")
}
